<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ru.stachek66.nlp</groupId>
    <!--
        The artifactId carries the Scala binary version suffix (e.g. _2.13).
        This is the standard cross-build pattern used by Akka, Spark, Pekko, etc.
        Switch the active value with -P scala-2.12 or -P scala-2.13 (default).
    -->
    <artifactId>mystem-scala_${scala.compat.version}</artifactId>
    <version>0.3.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>A Scala/JVM wrapper for the Yandex.MyStem morphological analyzer (Russian language).</description>
    <url>https://github.com/alexeyev/mystem-scala</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Anton Alekseev</name>
            <email>anton.m.alexeyev@gmail.com</email>
            <url>https://alexeyev.github.io/</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/alexeyev/mystem-scala.git</connection>
        <developerConnection>scm:git:git@github.com:alexeyev/mystem-scala.git</developerConnection>
        <url>https://github.com/alexeyev/mystem-scala</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/alexeyev/mystem-scala/issues</url>
    </issueManagement>

    <prerequisites>
        <maven>3.6.0</maven>
    </prerequisites>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Java 8 bytecode for maximum consumer compatibility. -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>

        <!--
            Defaults; overridden by the scala-2.12 / scala-2.13 profiles.
            We pin to 2.13.16 (not the very latest 2.13.x) because scoverage
            only publishes its compiler-instrumentation jar
            (scalac-scoverage-plugin_2.13.<patch>) for specific Scala patch
            versions, and 2.13.16 is the latest one with that jar published.
            Bumping past it makes `mvn -P coverage verify` fail to resolve
            scalac-scoverage-plugin. See
            https://github.com/scoverage/scalac-scoverage-plugin .
        -->
        <scala.compat.version>2.13</scala.compat.version>
        <scala.version>2.13.18</scala.version>

        <!-- Library / tool versions. -->
        <slf4j.version>2.0.17</slf4j.version>
        <!-- 1.3.x is the last logback branch that still supports Java 8. -->
        <logback.version>1.5.32</logback.version>
        <commons.compress.version>1.28.0</commons.compress.version>
        <commons.io.version>2.22.0</commons.io.version>
        <typesafe.config.version>1.4.8</typesafe.config.version>
        <json.version>20251224</json.version>

        <scalatest.version>3.2.20</scalatest.version>
        <junit.version>4.13.2</junit.version>

        <!-- Plugin versions. -->
        <scala.plugin.version>4.9.10</scala.plugin.version>
        <maven.compiler.plugin.version>3.15.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.5</maven.surefire.plugin.version>
        <scalatest.plugin.version>2.2.0</scalatest.plugin.version>
        <maven.source.plugin.version>3.4.0</maven.source.plugin.version>
        <maven.javadoc.plugin.version>3.12.0</maven.javadoc.plugin.version>
        <maven.gpg.plugin.version>3.2.8</maven.gpg.plugin.version>
        <maven.enforcer.plugin.version>3.6.2</maven.enforcer.plugin.version>
        <maven.release.plugin.version>3.3.1</maven.release.plugin.version>
        <central.publishing.plugin.version>0.10.0</central.publishing.plugin.version>
        <scoverage.plugin.version>2.1.5</scoverage.plugin.version>
        <!--
            scalac-scoverage-plugin (the compiler-instrumentation jar) version.
            Has to exist as scalac-scoverage-plugin_<scala.version>:<this>.
            2.3.0 is published for both 2.13.16 and 2.12.20.
        -->
        <scoverage.scalacPluginVersion>2.3.0</scoverage.scalacPluginVersion>
        <!--
            mvn-scalafmt is a build-time plugin; its Scala suffix is independent
            of the project's `scala.compat.version`. Pin to 2.13.
        -->
        <scalafmt.plugin.version>1.1.1713302731.c3d0074</scalafmt.plugin.version>
    </properties>

    <dependencyManagement>
        <!--
            Pinning scala-library here forces every transitive resolver
            (notably scalatest) to converge on our chosen Scala patch
            version. Without this, the enforcer's dependencyConvergence
            rule trips whenever scalatest releases against a newer 2.13
            patch than ours (or vice versa).
        -->
        <dependencies>
            <dependency>
                <groupId>org.scala-lang</groupId>
                <artifactId>scala-library</artifactId>
                <version>${scala.version}</version>
            </dependency>
            <dependency>
                <groupId>org.scala-lang</groupId>
                <artifactId>scala-reflect</artifactId>
                <version>${scala.version}</version>
            </dependency>

            <!--
                commons-compress 1.27.1 transitively pulls in commons-io 2.16.1;
                we directly depend on 2.18.0. dependencyConvergence rightly
                refuses to choose, so we pin the resolved version explicitly.
                Same trick for slf4j-api, which logback drags in transitively.
            -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${commons.io.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala-library</artifactId>
            <version>${scala.version}</version>
            <!--
                We deliberately keep `compile` (the default) rather than
                `provided`. A Java consumer of this library must have
                scala-library at runtime — case classes, Option, Iterable
                instances all live there. Letting Maven pull it in
                transitively is the friendliest behavior for a mixed-language
                consumer base. For pure-Scala consumers, Maven's nearest-wins
                resolution makes their own scala-library declaration take
                precedence.
            -->
        </dependency>

        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>${json.version}</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>${commons.compress.version}</version>
        </dependency>

        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons.io.version}</version>
        </dependency>

        <dependency>
            <groupId>com.typesafe</groupId>
            <artifactId>config</artifactId>
            <version>${typesafe.config.version}</version>
        </dependency>

        <!-- =========== Test dependencies =========== -->

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.scalatest</groupId>
            <artifactId>scalatest_${scala.compat.version}</artifactId>
            <version>${scalatest.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <sourceDirectory>src/main/scala</sourceDirectory>
        <testSourceDirectory>src/test/scala</testSourceDirectory>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.scoverage</groupId>
                    <artifactId>scoverage-maven-plugin</artifactId>
                    <version>${scoverage.plugin.version}</version>
                    <configuration>
                        <scalaVersion>${scala.version}</scalaVersion>
                        <!--
                            Pin the runtime instrumentation jar (scalac-
                            scoverage-plugin_<scala>) to a version that's
                            actually published for our Scala patch versions.
                            The scoverage-maven-plugin 2.0.4 default of 2.1.1
                            is from 2023 and predates Scala 2.13.16 / 2.12.20,
                            so the build defaults to a non-existent artifact.
                            2.3.0 is published for both 2.13.16 and 2.12.20.
                        -->
                        <scalacPluginVersion>${scoverage.scalacPluginVersion}</scalacPluginVersion>
                        <!--
                            Coverage threshold is intentionally modest. The
                            wrapper has a few code paths (binary download +
                            unpack + native-process spawn) that can't be
                            unit-tested without network or a Russian-language
                            CLI on the box, so 100% is unreasonable. 50%
                            line / 40% branch with failOnMinimumCoverage=true
                            keeps the gate meaningful without becoming a
                            flake source.
                        -->
                        <minimumCoverage>50</minimumCoverage>
                        <minimumCoverageBranchTotal>40</minimumCoverageBranchTotal>
                        <failOnMinimumCoverage>true</failOnMinimumCoverage>
                        <highlighting>true</highlighting>
                        <aggregate>true</aggregate>
                        <!--
                            Don't instrument the model package. These types
                            are case-class apply/copy machinery and Scala
                            Enumeration boilerplate; scoverage would
                            otherwise count their synthetic methods against
                            the threshold for no real coverage signal.
                        -->
                        <excludedPackages>
                            ru.stachek66.nlp.mystem.model
                        </excludedPackages>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>

            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
                <version>${scala.plugin.version}</version>
                <configuration>
                    <scalaVersion>${scala.version}</scalaVersion>
                    <scalaCompatVersion>${scala.compat.version}</scalaCompatVersion>
                    <args>
                        <!-- Strict compiler-as-linter flags. -->
                        <arg>-deprecation</arg>
                        <arg>-feature</arg>
                        <arg>-unchecked</arg>
                        <arg>-Xlint:_</arg>
                        <arg>-encoding</arg>
                        <arg>UTF-8</arg>
                    </args>
                    <jvmArgs>
                        <jvmArg>-Xss4m</jvmArg>
                    </jvmArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>scala-compile</id>
                        <goals>
                            <goal>compile</goal>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
            </plugin>

            <!--
                Disable Surefire (the JUnit runner). The ScalaTest plugin
                drives our tests; leaving Surefire enabled would make it
                complain about no JUnit tests being present.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.scalatest</groupId>
                <artifactId>scalatest-maven-plugin</artifactId>
                <version>${scalatest.plugin.version}</version>
                <configuration>
                    <reportsDirectory>${project.build.directory}/scalatest-reports</reportsDirectory>
                    <junitxml>.</junitxml>
                    <stdout>WD</stdout>
                </configuration>
                <executions>
                    <execution>
                        <id>scala-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-em-all</id>
                        <phase>validate</phase>
                        <configuration>
                            <rules>
                                <dependencyConvergence />
                                <requireMavenVersion>
                                    <version>[3.6.0,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[1.8,)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven.source.plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven.javadoc.plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>${maven.release.plugin.version}</version>
                <configuration>
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                    <autoVersionSubmodules>true</autoVersionSubmodules>
                    <useReleaseProfile>false</useReleaseProfile>
                    <releaseProfiles>release</releaseProfiles>
                    <goals>deploy</goals>
                </configuration>
            </plugin>

            <!-- Linter / formatter: scalafmt -->
            <plugin>
                <groupId>org.antipathy</groupId>
                <!--
                    The Scala suffix on this plugin is the Scala version the
                    plugin itself was built against — it is *not* tied to the
                    Scala version of the project being built. We pin to _2.13.
                -->
                <artifactId>mvn-scalafmt_2.13</artifactId>
                <version>${scalafmt.plugin.version}</version>
                <configuration>
                    <configLocation>${project.basedir}/.scalafmt.conf</configLocation>
                    <skipSources>false</skipSources>
                    <skipTestSources>false</skipTestSources>
                    <respectVersion>true</respectVersion>
                </configuration>
                <executions>
                    <execution>
                        <id>validate-format</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>format</goal>
                        </goals>
                        <configuration>
                            <onlyChangedFiles>false</onlyChangedFiles>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>

        <profile>
            <id>scala-2.13</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <scala.compat.version>2.13</scala.compat.version>
                <!-- Pinned to 2.13.16 — see comment on scala.version above. -->
                <scala.version>2.13.16</scala.version>
            </properties>
        </profile>

        <profile>
            <id>scala-2.12</id>
            <properties>
                <scala.compat.version>2.12</scala.compat.version>
                <!-- 2.12.20 is the latest 2.12.x with a published
                     scalac-scoverage-plugin jar; same constraint as 2.13. -->
                <scala.version>2.12.20</scala.version>
            </properties>
        </profile>

        <!--
            Coverage profile. Run `mvn -Pcoverage verify` to instrument the
            Scala compile, run tests against the instrumented classes, and
            generate an HTML+XML report under target/scoverage. The build
            fails if line coverage drops below the threshold configured in
            <pluginManagement> above (currently 50% line / 40% branch).
            We don't activate this in the default profile because scoverage
            roughly doubles test-run time, which is fine for CI but painful
            for inner-loop dev. The CI workflow opts in explicitly.
        -->
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.scoverage</groupId>
                        <artifactId>scoverage-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>scoverage-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Activated automatically by the maven-release-plugin and on demand
            via -P release. Builds and signs sources/javadoc and uploads the
            bundle to the new Sonatype Central Portal. OSSRH was sunset on
            2025-06-30 (see https://central.sonatype.org/news/20250326_ossrh_sunset/ ),
            so the legacy nexus-staging-maven-plugin no longer works.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven.gpg.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central.publishing.plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!--
                                When true, the bundle is published to Central
                                immediately after validation; leave it false
                                during initial setup so the deployment can be
                                reviewed in the Portal UI first.
                            -->
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>

</project>
